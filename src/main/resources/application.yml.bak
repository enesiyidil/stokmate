server:
  port: ${APP_PORT:9090}

spring:
  datasource:
    url: ${DB_URL:jdbc:postgresql://localhost:5432/stokmate}
    username: ${DB_USERNAME:stokmate}
    password: ${DB_PASSWORD:stokmate}
  jpa:
    hibernate:
      ddl-auto: update  # TEMPORARY: Will drop and recreate all tables! Change back to 'update' after restart
    properties:
      hibernate:
        format_sql: true
    open-in-view: false
  jackson:
    serialization:
      write-dates-as-timestamps: false

app:
  security:
    jwt:
      secret: ${JWT_SECRET:changeme-please-change-secret-key-should-be-long}
      expiration-ms: ${JWT_EXPIRATION_MS:86400000}
  minio:
    url: ${MINIO_URL:http://localhost:9000}
    access-key: ${MINIO_ACCESS_KEY:minioadmin}
    secret-key: ${MINIO_SECRET_KEY:minioadmin}
    bucket: ${MINIO_BUCKET:invoices}
  admin:
    email: ${ADMIN_EMAIL:admin@stokmate.local}
    password: ${ADMIN_PASSWORD:admin123}

springdoc:
  api-docs:
    enabled: true
  swagger-ui:
    enabled: true
