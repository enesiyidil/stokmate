# Copy to .env next to docker-compose.yml before `docker compose up`.
# Change every default secret before any shared or internet-facing deploy.

DB_NAME=stokmate
DB_USERNAME=stokmate
DB_PASSWORD=changeme-db-password

JWT_SECRET=changeme-please-change-secret-key-should-be-long
JWT_EXPIRATION_MS=86400000

ADMIN_EMAIL=admin@stokmate.local
ADMIN_PASSWORD=changeme-admin-password

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=invoices

# Optional mail. Leave empty to skip outbound email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=

# URL people use to open the UI (password-reset links, QR codes)
APP_FRONTEND_URL=http://localhost:8080

# Set to `demo` to load sample stores and products on first boot.
SPRING_PROFILES_ACTIVE=demo
FLYWAY_ENABLED=false
