```typescript
import { Package, Truck, CheckCircle, Clock, FileText, Upload, Camera, AlertCircle } from 'lucide-react'
import { useState, useEffect } from 'react'
import * as shipmentApi from '../../services/shipmentApi' // Changed to * as shipmentApi
import { useGetOrdersQuery } from '../../services/orderApi'
import { useTopbar } from '../../context/TopbarContext' // Changed context path

type ShipmentResponse = {
    id: string
    orderNo: string
    plannedShipmentDate?: string
    status: string
}

const ShipmentOperationsPage: React.FC = () => {
    const { setTopbarContent } = useTopbar()
    const [activeTab, setActiveTab] = useState<'pending' | 'ready'>('pending')
    const [pendingApprovals, setPendingApprovals] = useState<any[]>([]) // Renamed from pendingOrders
    const [approvingId, setApprovingId] = useState<string | null>(null)

    // Existing state
    const [shipments, setShipments] = useState<ShipmentResponse[]>([]) // Renamed from readyShipments, added type
    const [selectedShipment, setSelectedShipment] = useState<ShipmentResponse | null>(null) // Added type
    const [loading, setLoading] = useState(false)

    // Form state
    const [deliveryStatus, setDeliveryStatus] = useState<'PROBLEM_FREE' | 'PROBLEMATIC'>('PROBLEM_FREE') // Changed WITH_ISSUES to PROBLEMATIC
    const [problemType, setProblemType] = useState<'FACTORY_DEFECT' | 'TRANSPORT_ASSEMBLY_DEFECT'>('FACTORY_DEFECT') // Added problemType
    const [deliveryNotes, setDeliveryNotes] = useState('')
    const [signedDocument, setSignedDocument] = useState<File | null>(null)
    const [deliveryPhotos, setDeliveryPhotos] = useState<FileList | null>(null)

    // Get orders with PENDING_SHIPMENT_APPROVAL status
    const { data: allOrders } = useGetOrdersQuery()

    useEffect(() => {
        if (allOrders) {
            const pending = allOrders.filter(o => o.status === 'PENDING_SHIPMENT_APPROVAL')
            setPendingApprovals(pending)
        }
    }, [allOrders])

    useEffect(() => {
        loadData()
    }, [activeTab])

    useEffect(() => {
        // Set topbar content
        setTopbarContent({
            title: 'Sevkiyat İşlemleri',
            description: 'Sevkiyat onayları ve teslimat işlemleri',
            icon: <Truck className="w-8 h-8" />,
            showFiltersInTopbar: false,
            actions: (
                <div className="flex items-center gap-2">
                    <span className={`px - 3 py - 1 rounded - lg text - sm font - medium border flex items - center gap - 2 ${
    activeTab === 'pending'
    ? 'bg-orange-500/20 text-orange-200 border-orange-400/30'
    : 'bg-green-500/20 text-green-200 border-green-400/30'
} `}>
                        {activeTab === 'pending' ? (
                            <>
                                <Clock className="w-4 h-4" />
                                <span>{pendingApprovals.length} Onay Bekliyor</span>
                            </>
                        ) : (
                            <>
                                <Package className="w-4 h-4" />
                                <span>{shipments.length} Sevke Hazır</span>
                            </>
                        )}
                    </span>
                </div>
            )
        })

        return () => setTopbarContent(null)
    }, [setTopbarContent, activeTab, pendingApprovals.length, shipments.length])

        alert('Hata: ' + (error.response?.data?.message || error.message))
    }
}

const handleCompleteShipment = async (shipmentId: string) => {
    const formData = new FormData()
    formData.append('shipmentId', shipmentId)
    formData.append('deliveryStatus', deliveryStatus)
    if (deliveryStatus === 'PROBLEMATIC') {
        formData.append('problemType', problemType)
    }
    formData.append('deliveryNotes', deliveryNotes)
    if (signedDocument) {
        formData.append('signedDocument', signedDocument)
    }
    if (deliveryPhotos) {
        Array.from(deliveryPhotos).forEach(photo => {
            formData.append('deliveryPhotos', photo)
        })
    }

    try {
        setLoading(true)
        await shipmentApi.completeShipment(formData)
        alert('Sevkiyat tamamlandı!')
        setSelectedShipment(null)
        await loadData()

        // Reset form
        setDeliveryStatus('PROBLEM_FREE')
        setDeliveryNotes('')
        setSignedDocument(null)
        setDeliveryPhotos(null)
    } catch (error: any) {
        alert('Hata: ' + (error.response?.data?.message || error.message))
    } finally {
        setLoading(false)
    }
}

return (
    <div className="p-6">
        {/* Filter Bar */}
        <div className="mb-6 flex items-center gap-3">
            <button
                onClick={() => setActiveTab('pending')}
                className={`px - 4 py - 2 rounded - lg text - sm font - medium transition - all ${
    activeTab === 'pending'
    ? 'bg-gradient-to-r from-orange-500 to-amber-600 text-white shadow-lg'
    : 'bg-white/10 text-purple-300 hover:bg-white/20'
} `}
            >
                <div className="flex items-center gap-2">
                    <Clock className="w-4 h-4" />
                    Onay Bekleyenler
                </div>
            </button>
            <button
                onClick={() => setActiveTab('ready')}
                className={`px - 4 py - 2 rounded - lg text - sm font - medium transition - all ${
    activeTab === 'ready'
    ? 'bg-gradient-to-r from-green-500 to-emerald-600 text-white shadow-lg'
    : 'bg-white/10 text-purple-300 hover:bg-white/20'
} `}
            >
                <div className="flex items-center gap-2">
                    <Package className="w-4 h-4" />
                    Sevke Hazır
                </div>
            </button>
        </div>

        {/* Content */}
        {activeTab === 'pending' ? (
            <div className="backdrop-blur-xl bg-white/10 border border-white/20 rounded-2xl shadow-2xl overflow-hidden">
                <div className="p-6 bg-gradient-to-r from-orange-500/20 to-amber-500/20 border-b border-white/10">
                    <div className="flex items-center gap-3">
                        <Clock className="w-6 h-6 text-orange-300" />
                        <h2 className="text-xl font-semibold text-white">Sevk Onayı Bekleyen Siparişler</h2>
                    </div>
                </div>
                {loading ? (
                    <div className="p-12 text-center">
                        <div className="inline-block animate-spin rounded-full h-12 w-12 border-b-2 border-purple-500"></div>
                        <p className="text-purple-300 mt-4">Yükleniyor...</p>
                    </div>
                ) : pendingApprovals.length === 0 ? (
                    <div className="p-12 text-center">
                        <div className="inline-block p-4 bg-white/5 rounded-full mb-4">
                            <CheckCircle className="w-12 h-12 text-green-400" />
                        </div>
                        <p className="text-purple-300 text-lg">Onay bekleyen sipariş bulunmuyor</p>
                        <p className="text-purple-400 text-sm mt-2">Tüm siparişler onaylanmış durumda</p>
                    </div>
                ) : (
                    <div className="divide-y divide-white/10">
                        {pendingApprovals.map((item) => (
                            <div key={item.orderId} className="p-6 hover:bg-white/5 transition-all duration-300 group">
                                <div className="flex items-center justify-between">
                                    <div className="flex-1">
                                        <div className="flex items-center gap-3 mb-2">
                                            <div className="p-2 bg-gradient-to-br from-orange-500/20 to-amber-500/20 rounded-lg">
                                                ) : (
                                                <div className="overflow-x-auto">
                                                    <table className="w-full">
                                                        <thead>
                                                            <tr className="border-b border-white/10">
                                                                <th className="text-left py-3 px-4 text-sm font-semibold text-purple-200">Sipariş No</th>
                                                                <th className="text-left py-3 px-4 text-sm font-semibold text-purple-200">Müşteri</th>
                                                                <th className="text-left py-3 px-4 text-sm font-semibold text-purple-200">Sözleşme No</th>
                                                                <th className="text-left py-3 px-4 text-sm font-semibold text-purple-200">Ürün Adedi</th>
                                                                <th className="text-left py-3 px-4 text-sm font-semibold text-purple-200">Sipariş Tarihi</th>
                                                                <th className="text-left py-3 px-4 text-sm font-semibold text-purple-200">Durum</th>
                                                                <th className="text-right py-3 px-4 text-sm font-semibold text-purple-200">İşlemler</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            {filteredPendingOrders.map((order) => {
                                                                const totalProducts = order.products?.reduce((sum, p) => sum + (p.quantity || 0), 0) || 0
                                                                const customerName = order.customer
                                                                    ? `${ order.customer.firstName } ${ order.customer.lastName } `
                                                                    : order.prosapContractNameSurname || '-'

                                                                return (
                                                                    <tr key={order.id} className="border-b border-white/5 hover:bg-white/5 transition-colors">
                                                                        <td className="py-3 px-4">
                                                                            <span className="text-white font-medium">{order.orderNo}</span>
                                                                        </td>
                                                                        <td className="py-3 px-4">
                                                                            <span className="text-white">{customerName}</span>
                                                                        </td>
                                                                        <td className="py-3 px-4">
                                                                            <span className="text-purple-200">{order.prosapContractNo || '-'}</span>
                                                                        </td>
                                                                        <td className="py-3 px-4">
                                                                            <span className="text-white font-semibold">{totalProducts}</span>
                                                                            <span className="text-purple-300 text-sm ml-1">adet</span>
                                                                        </td>
                                                                        <td className="py-3 px-4">
                                                                            <span className="text-purple-200">
                                                                                {order.orderDate ? new Date(order.orderDate).toLocaleDateString('tr-TR') : '-'}
                                                                            </span>
                                                                        </td>
                                                                        <td className="py-3 px-4">
                                                                            <span className="px-3 py-1 rounded-full text-xs font-medium bg-yellow-500/20 text-yellow-300 border border-yellow-500/30">
                                                                                Onay Bekliyor
                                                                            </span>
                                                                        </td>
                                                                        <td className="py-3 px-4 text-right">
                                                                            <button
                                                                                onClick={() => handleApproveShipment(order.id)}
                                                                                disabled={approvingId === order.id}
                                                                                className="px-4 py-2 bg-gradient-to-r from-green-500 to-emerald-600 hover:from-green-600 hover:to-emerald-700 text-white rounded-lg font-medium transition-all duration-200 shadow-lg hover:shadow-green-500/50 disabled:opacity-50 disabled:cursor-not-allowed"
                                                                            >
                                                                                {approvingId === order.id ? (
                                                                                    <span className="flex items-center gap-2">
                                                                                        <div className="w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin" />
                                                                                        Onaylanıyor...
                                                                                    </span>
                                                                                ) : (
                                                                                    <span className="flex items-center gap-2">
                                                                                        <CheckCircle className="w-4 h-4" />
                                                                                        Sevk Onayla
                                                                                    </span>
                                                                                )}
                                                                            </button>
                                                                        </td>
                                                                    </tr>
                                                                )
                                                            })}
                                                        </tbody>
                                                    </table>
                                                    {filteredPendingOrders.length === 0 && (
                                                        <div className="text-center py-12">
                                                            <Package className="w-16 h-16 text-purple-300/50 mx-auto mb-4" />
                                                            <p className="text-purple-200">Sevk onayı bekleyen sipariş bulunmuyor</p>
                                                        </div>
                                                    )}
                                                </div>
                    )}
                                            </div>
                                            ) : selectedShipment ? (
                                            <div className="backdrop-blur-xl bg-white/10 border border-white/20 rounded-2xl shadow-2xl p-6">
                                                <div className="flex justify-between items-center mb-6">
                                                    <div className="flex items-center gap-3">
                                                        <div className="p-3 bg-gradient-to-br from-blue-500 to-purple-600 rounded-xl">
                                                            <Truck className="w-6 h-6 text-white" />
                                                        </div>
                                                        <div>
                                                            <h2 className="text-2xl font-semibold text-white">Sevkiyat Tamamla</h2>
                                                            <p className="text-purple-300">Sipariş: {selectedShipment.orderNo}</p>
                                                        </div>
                                                    </div>
                                                    <button
                                                        onClick={() => setSelectedShipment(null)}
                                                        className="p-2 hover:bg-white/10 rounded-lg transition-colors text-purple-300 hover:text-white"
                                                    >
                                                        ✕
                                                    </button>
                                                </div>

                                                <div className="space-y-6">
                                                    {/* Delivery Status */}
                                                    <div>
                                                        <label className="block text-white font-medium mb-3 flex items-center gap-2">
                                                            <CheckCircle className="w-5 h-5 text-purple-400" />
                                                            Teslimat Durumu
                                                        </label>
                                                        <div className="grid grid-cols-2 gap-3">
                                                            <button
                                                                onClick={() => setDeliveryStatus('PROBLEM_FREE')}
                                                                className={`p - 4 rounded - xl border - 2 transition - all ${
    deliveryStatus === 'PROBLEM_FREE'
    ? 'bg-green-500/20 border-green-500 text-white'
    : 'bg-white/5 border-white/20 text-purple-300 hover:bg-white/10'
} `}
                                                            >
                                                                <CheckCircle className="w-6 h-6 mx-auto mb-2" />
                                                                Sorunsuz
                                                            </button>
                                                            <button
                                                                onClick={() => setDeliveryStatus('PROBLEMATIC')}
                                                                className={`p - 4 rounded - xl border - 2 transition - all ${
    deliveryStatus === 'PROBLEMATIC'
    ? 'bg-red-500/20 border-red-500 text-white'
    : 'bg-white/5 border-white/20 text-purple-300 hover:bg-white/10'
} `}
                                                            >
                                                                <AlertCircle className="w-6 h-6 mx-auto mb-2" />
                                                                Sorunlu
                                                            </button>
                                                        </div>
                                                    </div>

                                                    {/* Problem Type */}
                                                    {deliveryStatus === 'PROBLEMATIC' && (
                                                        <div className="animate-fadeIn">
                                                            <label className="block text-white font-medium mb-3">Sorun Tipi</label>
                                                            <select
                                                                className="w-full bg-white/10 border border-white/20 rounded-xl p-3 text-white backdrop-blur-xl focus:outline-none focus:border-purple-500 transition-colors"
                                                                value={problemType}
                                                                onChange={(e) => setProblemType(e.target.value as any)}
                                                            >
                                                                <option value="FACTORY_DEFECT">Fabrika Hatası</option>
                                                                <option value="TRANSPORT_ASSEMBLY_DEFECT">Taşıma/Montaj Hatası</option>
                                                            </select>
                                                        </div>
                                                    )}

                                                    {/* Notes */}
                                                    <div>
                                                        <label className="block text-white font-medium mb-3 flex items-center gap-2">
                                                            <FileText className="w-5 h-5 text-purple-400" />
                                                            Teslimat Notları
                                                        </label>
                                                        <textarea
                                                            className="w-full bg-white/10 border border-white/20 rounded-xl p-3 text-white placeholder-purple-400 backdrop-blur-xl focus:outline-none focus:border-purple-500 transition-colors resize-none"
                                                            rows={4}
                                                            value={deliveryNotes}
                                                            onChange={(e) => setDeliveryNotes(e.target.value)}
                                                            placeholder="Teslimat hakkında notlar..."
                                                        />
                                                    </div>

                                                    {/* Document Upload */}
                                                    <div>
                                                        <label className="block text-white font-medium mb-3 flex items-center gap-2">
                                                            <FileText className="w-5 h-5 text-purple-400" />
                                                            İmzalı Belge
                                                        </label>
                                                        <label className="flex items-center justify-center gap-3 px-6 py-4 bg-white/5 border-2 border-dashed border-white/20 rounded-xl hover:bg-white/10 hover:border-purple-500 transition-all cursor-pointer group">
                                                            <Upload className="w-6 h-6 text-purple-400 group-hover:text-purple-300" />
                                                            <span className="text-purple-300 group-hover:text-white">
                                                                {signedDocument ? signedDocument.name : 'Belge seçin'}
                                                            </span>
                                                            <input
                                                                type="file"
                                                                className="hidden"
                                                                accept=".pdf,.jpg,.jpeg,.png"
                                                                onChange={(e) => setSignedDocument(e.target.files?.[0] || null)}
                                                            />
                                                        </label>
                                                    </div>

                                                    {/* Photos */}
                                                    <div>
                                                        <label className="block text-white font-medium mb-3 flex items-center gap-2">
                                                            <Camera className="w-5 h-5 text-purple-400" />
                                                            Teslimat Fotoğrafları
                                                        </label>
                                                        <label className="flex items-center justify-center gap-3 px-6 py-4 bg-white/5 border-2 border-dashed border-white/20 rounded-xl hover:bg-white/10 hover:border-purple-500 transition-all cursor-pointer group">
                                                            <Camera className="w-6 h-6 text-purple-400 group-hover:text-purple-300" />
                                                            <span className="text-purple-300 group-hover:text-white">
                                                                {deliveryPhotos ? `${ deliveryPhotos.length } fotoğraf seçildi` : 'Fotoğraf seçin'}
                                                            </span>
                                                            <input
                                                                type="file"
                                                                className="hidden"
                                                                accept="image/*"
                                                                multiple
                                                                onChange={(e) => setDeliveryPhotos(e.target.files)}
                                                            />
                                                        </label>
                                                    </div>

                                                    <button
                                                        onClick={() => handleCompleteShipment(selectedShipment.id)}
                                                        disabled={loading}
                                                        className="w-full bg-gradient-to-r from-green-500 to-emerald-600 text-white rounded-xl px-6 py-4 font-medium hover:shadow-lg hover:shadow-green-500/50 transition-all disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2"
                                                    >
                                                        {loading ? (
                                                            <>
                                                                <div className="w-5 h-5 border-2 border-white/30 border-t-white rounded-full animate-spin"></div>
                                                                Kaydediliyor...
                                                            </>
                                                        ) : (
                                                            <>
                                                                <CheckCircle className="w-5 h-5" />
                                                                Sevkiyatı Tamamla
                                                            </>
                                                        )}
                                                    </button>
                                                </div>
                                            </div>
                                            ) : (
                                            <div className="backdrop-blur-xl bg-white/10 border border-white/20 rounded-2xl shadow-2xl overflow-hidden">
                                                <div className="p-6 bg-gradient-to-r from-green-500/20 to-emerald-500/20 border-b border-white/10">
                                                    <div className="flex items-center gap-3">
                                                        <Package className="w-6 h-6 text-green-300" />
                                                        <h2 className="text-xl font-semibold text-white">Sevke Hazır Siparişler</h2>
                                                    </div>
                                                </div>

                                                {loading ? (
                                                    <div className="p-12 text-center">
                                                        <div className="inline-block animate-spin rounded-full h-12 w-12 border-b-2 border-purple-500"></div>
                                                        <p className="text-purple-300 mt-4">Yükleniyor...</p>
                                                    </div>
                                                ) : shipments.length === 0 ? (
                                                    <div className="p-12 text-center">
                                                        <div className="inline-block p-4 bg-white/5 rounded-full mb-4">
                                                            <Package className="w-12 h-12 text-purple-400" />
                                                        </div>
                                                        <p className="text-purple-300 text-lg">Sevke hazır sipariş yok</p>
                                                        <p className="text-purple-400 text-sm mt-2">Onaylanan siparişler burada görünecek</p>
                                                    </div>
                                                ) : (
                                                    <div className="divide-y divide-white/10">
                                                        {shipments.map(shipment => (
                                                            <div key={shipment.id} className="p-6 hover:bg-white/5 transition-all duration-300 group">
                                                                <div className="flex items-center justify-between">
                                                                    <div className="flex-1">
                                                                        <div className="flex items-center gap-3 mb-2">
                                                                            <div className="p-2 bg-gradient-to-br from-green-500/20 to-emerald-500/20 rounded-lg">
                                                                                <Truck className="w-5 h-5 text-green-300" />
                                                                            </div>
                                                                            <div>
                                                                                <h3 className="text-white font-semibold text-lg">{shipment.orderNo}</h3>
                                                                                <p className="text-purple-300 text-sm">
                                                                                    Planlanan: {shipment.plannedShipmentDate
                                                                                        ? new Date(shipment.plannedShipmentDate).toLocaleDateString('tr-TR')
                                                                                        : '-'}
                                                                                </p>
                                                                            </div>
                                                                        </div>
                                                                        <span className="px-3 py-1 bg-green-500/20 text-green-300 rounded-lg text-xs font-medium border border-green-500/30">
                                                                            Sevke Hazır
                                                                        </span>
                                                                    </div>
                                                                    <button
                                                                        onClick={() => setSelectedShipment(shipment)}
                                                                        className="px-6 py-3 bg-gradient-to-r from-blue-500 to-purple-600 text-white rounded-xl font-medium hover:shadow-lg hover:shadow-blue-500/50 transition-all duration-300 transform hover:scale-105 flex items-center gap-2"
                                                                    >
                                                                        <Truck className="w-5 h-5" />
                                                                        Tamamla
                                                                    </button>
                                                                </div>
                                                            </div>
                                                        ))}
                                                    </div>
                                                )}
                                            </div>
            )}
                                        </div>
                                        )
}

                                        export default ShipmentOperationsPage
