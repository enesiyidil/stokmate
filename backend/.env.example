# Copy to .env and replace placeholder values before running locally.
# Never commit a real .env file.

APP_PORT=9090
DB_URL=jdbc:postgresql://localhost:5432/stokmate
DB_USERNAME=stokmate
DB_PASSWORD=changeme-db-password
DB_NAME=stokmate

# Use a long random string in any shared or production environment.
JWT_SECRET=changeme-please-change-secret-key-should-be-long
JWT_EXPIRATION_MS=86400000

ADMIN_EMAIL=admin@stokmate.local
ADMIN_PASSWORD=changeme-admin-password

MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=invoices

# Optional outbound email. Leave empty to skip mail features.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=

# Public URL of the UI (password-reset links, PDF QR codes, etc.)
APP_FRONTEND_URL=http://localhost:5173

# Set true only when applying versioned SQL migrations to an existing database.
FLYWAY_ENABLED=false
